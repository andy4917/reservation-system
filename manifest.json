{
  "manifest_version": 3,
  "name": "UHS 예약 통합관리",
  "version": "0.5.0",
  "description": "예약 재고를 한곳에서 조회하고 반영하는 확장 프로그램입니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "cookies",
    "storage",
    "clipboardWrite",
    "scripting"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "host_permissions": [
    "https://*/*",
    "https://partner.booking.naver.com/*",
    "https://api-partner.booking.naver.com/*",
    "https://admin.admin-stationbyuhc.com/*",
    "https://api.admin-stationbyuhc.com/*",
    "https://sheets.googleapis.com/*",
    "https://oauth2.googleapis.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://partner.booking.naver.com/*",
        "https://admin.admin-stationbyuhc.com/*",
        "https://pms.sanhait.com/*"
      ],
      "js": [
        "src/shared/entryPolicy.js",
        "src/extensionBridge.entry.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
