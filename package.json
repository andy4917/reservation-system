{
  "name": "uhs-desktop-app",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop-first shell for the reservation integration management system.",
  "main": "dist-app/main/main.js",
  "scripts": {
    "app:dev:renderer": "vite --config app/vite.config.ts",
    "app:build:renderer": "vite build --config app/vite.config.ts",
    "app:build:main": "tsc -p tsconfig.json && node scripts/write-dist-app-package-json.mjs",
    "app:build": "npm run app:build:renderer && npm run app:build:main",
    "app:preview": "vite preview --config app/vite.config.ts",
    "app:electron": "npm run app:build:main && electron .",
    "app:check": "tsc -p tsconfig.json --noEmit",
    "app:verify:sheet-live": "npm run app:build:main && node scripts/live_sheet_verify.mjs",
    "extension:contracts:check": "tsc -p tsconfig.extension-contracts.json --noEmit",
    "extension:package": "./tasks/build_extension_unpacked.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.6"
  }
}
